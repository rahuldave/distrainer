# Copy to .env for local secrets and runtime configuration. Keep .env ignored.
# S3-compatible storage for the docker compose harness (MinIO defaults).
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=distrainer
S3_SECRET_KEY=distrainer123
S3_REGION=auto
DISTRAINER_STORAGE_PATH=distrainer/runs

# Multi-node harness (deploy/driver.sh); all optional
# DISTRAINER_DRIVER=compose          # which deploy/drivers/<name>.sh runs the verbs
# DISTRAINER_SHARED=./.harness/shared   # host path bind-mounted at /shared in every container
# DISTRAINER_MINIO=1                 # add the MinIO profile to every compose call
# DISTRAINER_RESTART_DELAY=5         # seconds before a killed worker container is started again
# DISTRAINER_IMAGE=distrainer:local  # the node image: a local name is built for the Mac's architecture and pushed to the machines;
#                                    # a registry image (host/name:tag, what `aws.sh ecr` records) is built for DISTRAINER_PLATFORMS,
#                                    # pushed once, and pulled by every machine
# DISTRAINER_PLATFORMS=              # linux/amd64,linux/arm64 for a registry image (one manifest); a single platform to cross-build a local one
# DISTRAINER_BUILDER=distrainer      # the docker-container buildx builder a registry build uses (created when missing)
#                                    # a "registry image" has a dot, a colon or `localhost` in its first path component (Docker's rule):
#                                    # myorg/distrainer:local is a local name
# uncloud driver (DISTRAINER_DRIVER=uncloud; deploy/drivers/uncloud.sh, deploy/uncloud/machines.sh)
# DISTRAINER_UNCLOUD_CONTEXT=distrainer      # the uc context every call names
# DISTRAINER_UNCLOUD_MACHINES="uc1 uc2 uc3"  # the first is the head machine (head, MinIO, the driver)
# DISTRAINER_UNCLOUD_SSH=%s@orb              # ssh destination for docker kill on a machine (printf template)
# DISTRAINER_UNCLOUD_HOST_PREFIX=192.168.138.0/23   # where the head machine publishes ports (OrbStack's machine network)
# DISTRAINER_UNCLOUD_HEAD_MACHINE=uc1        # defaults to the first machine; DISTRAINER_UNCLOUD_WORKER_MACHINES=uc2,uc3 to the rest
# DISTRAINER_UNCLOUD_HEAD_ADDRESS=           # what `endpoint` prints instead of the head machine's WireGuard endpoint address
# DISTRAINER_UNCLOUD_HEAD_MEMORY=5G          # machines.sh: cgroup caps for the machines it creates
# DISTRAINER_UNCLOUD_WORKER_MEMORY=2G
# DISTRAINER_UNCLOUD_SSH_OPTS=               # extra ssh options for that route (`-F .harness/aws/ssh_config` on AWS)
# DISTRAINER_UNCLOUD_PROVIDER=orbstack       # whose bootstrap machines-up, machines-status, machines-stop, machines-start and
#                                            # machines-destroy drive: orbstack (machines.sh) or aws (aws.sh)
# DISTRAINER_ENV_FILE=.harness/aws/env       # a second env file the uncloud driver and the runner read after this one
#                                            # (deploy/uncloud/aws.sh writes it: the context, the machines, the ssh route,
#                                            # the head's public address and the S3 settings of the bucket it created);
#                                            # what your shell exports wins over both files
# A store outside the cluster (the AWS bed, or any S3-compatible service) replaces the MinIO lines above:
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com   # the driver's `endpoint` then prints s3=<this> and the runner deploys no MinIO
# S3_REGION=us-east-1
# S3_ACCESS_KEY=<a user scoped to the bucket>
# S3_SECRET_KEY=...
# The AWS bed (deploy/uncloud/aws.sh; every one optional, the defaults in its header):
# DISTRAINER_AWS_PROFILE=                    # an AWS CLI profile (the default profile otherwise)
# DISTRAINER_AWS_REGION=us-east-1
# DISTRAINER_AWS_HEAD_TYPE=t3.large          # DISTRAINER_AWS_WORKER_TYPE=t3.medium; DISTRAINER_AWS_ARCH=amd64 (arm64 with t4g types)
# DISTRAINER_AWS_ECR_REPOSITORY=distrainer   # the private image repository `aws.sh ecr` creates
# DISTRAINER_AWS_DISK_GB=16
# DISTRAINER_AWS_NAME=distrainer             # the key pair, the security group, the IAM user (<name>-harness), the Name tags
# DISTRAINER_AWS_KEY=~/.ssh/distrainer-aws.pem
# DISTRAINER_AWS_USER=ubuntu
# DISTRAINER_AWS_ALLOW_CIDR=                 # where ssh is admitted from (this Mac's public address/32 by default; /24 at the widest)
# DISTRAINER_AWS_BUCKET=                     # the bucket (the one examples/hello_blocks/harness-s3.yaml names by default)
