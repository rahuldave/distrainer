# distrainer GPU node image for RunPod pods (linux/amd64 only). The same base, uv layout, scripts
# and environment as deploy/Dockerfile, with two differences:
#   - torch and torchvision are the CUDA 12.6 wheels of the versions uv.lock pins (the ARGs below;
#     tests/test_deploy_manifests.py keeps them equal to the lock): the locked sync skips the two
#     CPU wheels and a layer of its own installs the CUDA ones (about 6.5 GB with the NVIDIA
#     libraries; the CUDA runtime rides in them and the driver comes from the host through
#     RunPod's NVIDIA runtime, so no CUDA base image is needed). uv has no default extras,
#     which is why this is not a `gpu` extra of pyproject.toml: an extra-conditional torch source
#     would take torch out of the base dependencies and every plain `uv run` would lose it.
#   - sshd, started from RunPod's PUBLIC_KEY by deploy/runpod-entry.sh (the entrypoint), so the
#     driver's exec-head is an ssh command; the role (head | worker) is the CMD.
# Built and pushed by .github/workflows/gpu-image.yml to ghcr.io/rahuldave/distrainer-gpu (a public
# package: RunPod pulls it with no credentials); about 3 GB of CUDA wheels, so not built from a
# laptop uplink. Build with `--platform linux/amd64`.
FROM python:3.13-slim
ARG TORCH_VERSION=2.14.0
ARG TORCHVISION_VERSION=0.29.0
ARG CUDA_TAG=cu126
COPY --from=ghcr.io/astral-sh/uv:0.9.8 /uv /uvx /usr/local/bin/
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RAY_TRAIN_V2_ENABLED=1 \
    RAY_ENABLE_UV_RUN_RUNTIME_ENV=0 \
    RAY_DISABLE_DOCKER_CPU_WARNING=1
WORKDIR /app
# procps for the runner's pkill; openssh-server for the pod's ssh access (host keys made now)
RUN apt-get update && apt-get install -y --no-install-recommends procps openssh-server \
    && rm -rf /var/lib/apt/lists/* && ssh-keygen -A && mkdir -p /run/sshd
# the locked dependencies without the two CPU wheels (their dependencies are still installed)
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project \
    --no-install-package torch --no-install-package torchvision
# the CUDA wheels of the same versions (`+cu126` spelled out: uv holds `==2.14.0` satisfied otherwise)
RUN --mount=type=cache,target=/root/.cache/uv uv pip install --python /app/.venv \
    --index "https://download.pytorch.org/whl/${CUDA_TAG}" \
    "torch==${TORCH_VERSION}+${CUDA_TAG}" "torchvision==${TORCHVISION_VERSION}+${CUDA_TAG}"
# the project itself, editable like `uv sync` installs it (a plain sync would install CPU torch)
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv uv pip install --python /app/.venv --no-deps -e .
ENV PATH="/app/.venv/bin:$PATH"
RUN chmod +x deploy/ray-head.sh deploy/ray-worker.sh deploy/runpod-entry.sh
RUN printf 'export PATH=/app/.venv/bin:$PATH\n' > /etc/profile.d/distrainer-venv.sh
ENTRYPOINT ["deploy/runpod-entry.sh"]
CMD ["head"]
